# Core service
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*

# Market / trading
BINANCE_BASE_URL=https://api.binance.us
BINANCE_API_KEY=
BINANCE_API_SECRET=
BARK_NOTIFY_URL=

# AI recognition
OPENROUTER_API_KEY=sk-or-your-openrouter-key
OPENROUTER_MODEL=openai/gpt-5.3-codex
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# Telegram bot defaults
AI_DEFAULT_SYMBOL=BTCUSDT
AI_DEFAULT_TIMEFRAME=1h
AI_DEFAULT_USD_AMOUNT=100
AI_DEFAULT_MODE=simulate
AI_DEFAULT_CHART_TIMEZONE=UTC
AI_DEFAULT_LINE_HINT=

# Telegram bot
TELEGRAM_BOT_TOKEN=123456789:replace-with-your-bot-token
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_TIMEOUT_SECONDS=60
